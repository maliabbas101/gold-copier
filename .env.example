# Load explicitly through your process manager or Docker Compose.
PUBLIC_URL=http://127.0.0.1:8000
PLATFORM_DB=platform.db
# Generate with: python -m goldcopier.manage key
VAULT_KEY=
DEMO_MODE=false
ALLOW_LIVE_TRADING=false
BILLING_ENABLED=false
DISCORD_BOT_TOKEN=
# Random 48+ byte token, only if deploying a managed Windows pool.
SUPERVISOR_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional direct MT5 analyst bridge
SIGNAL_INGEST_TOKEN=
MIRROR_ANALYST_ID=
MASTER_TERMINAL_PATH=
MASTER_LOGIN=
MASTER_SERVER=
MASTER_SYMBOL=XAUUSD
