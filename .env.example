# Copy to .env, fill in the 3 Discord lines, then run:
#   python -m goldcopier.manage run
# Everything else is detected or generated on first start.

# --- Discord: the only required settings -----------------------------------
DISCORD_BOT_TOKEN=
# Right-click the signal channel > Copy Channel ID (Discord Developer Mode on).
DISCORD_CHANNEL_ID=
# Right-click the signal poster (human or bot) > Copy User ID.
DISCORD_TRADER_ID=

# --- MT5: leave blank if MetaTrader 5 is already logged in to your demo -------
# account with "Save password" ticked. Login, server, demo/live and the gold
# symbol are then read from the terminal. MT5_PASSWORD is the trading password.
MT5_LOGIN=
MT5_SERVER=
MT5_PASSWORD=

# --- Optional overrides (blank = automatic) ---------------------------------
# App login. Blank: admin@goldcopier.local with a generated password saved in
# .local-runtime/admin-password (printed on first start).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Blank: the only terminal64.exe under Program Files.
MT5_TERMINAL_PATH=
# Blank: XAUUSD, or your broker's variant such as XAUUSDm.
MT5_SYMBOL=
# Blank: looked up from DISCORD_CHANNEL_ID with the bot token.
DISCORD_GUILD_ID=
ANALYST_NAME=

# --- Advanced: not needed for local copying ---------------------------------
# Defaults: PUBLIC_URL=http://127.0.0.1:8001, LOCAL_STATE_DIR=.local-runtime,
# PLATFORM_DB=<state dir>/platform.db, MT5_FILLING_MODE=1 (IOC),
# ALLOW_LIVE_TRADING=false, BILLING_ENABLED=false.
# VAULT_KEY is generated into .local-runtime/vault-key; keep that file.
# AGENT_TOKEN is provisioned automatically by manage run. For a standalone
# platform_agent, create one with: python -m goldcopier.manage worker-token
# Optional features (see docs/PLATFORM.md): SUPERVISOR_TOKEN, STRIPE_*, SMTP_*,
# SIGNAL_INGEST_TOKEN, MIRROR_ANALYST_ID, MASTER_* and LOCAL_ACCOUNT_ID.

# Separate sender bot for scripts/test_signal_bot.py (not the listener's token).
TEST_DISCORD_BOT_TOKEN=
