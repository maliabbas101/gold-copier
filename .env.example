# Copy to .env, then run: python -m goldcopier.manage run
# Labels below describe the normal local Discord-to-MT5 setup.

# REQUIRED ON FIRST START: creates your app operator account.
# Not required again once an operator exists; changing these does not reset it.
ADMIN_EMAIL=
# Use 12-128 characters.
ADMIN_PASSWORD=

# REQUIRED FOR DISCORD SIGNALS: blank disables the Discord listener.
DISCORD_BOT_TOKEN=
# REQUIRED FOR A NEW SIGNAL SOURCE: fill all three IDs together.
# Optional if you already configured the analyst in the app/database.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_TRADER_ID=

# REQUIRED FOR LOCAL MT5: use the actual terminal64.exe path on your computer.
# Blank disables the local worker. Account login and server go in the app.
MT5_TERMINAL_PATH="C:\Program Files\MetaTrader 5\terminal64.exe"

# CONDITIONALLY REQUIRED: trading password for automatic MT5 login.
# Leave blank only if the terminal already has a working saved login.
MT5_PASSWORD=

# DEFAULTS: leave these unchanged for your first local demo-account setup.
# ANALYST_NAME is an optional display name.
ANALYST_NAME=My signal feed
PUBLIC_URL=http://127.0.0.1:8000
PLATFORM_DB=.local-runtime/platform.db
LOCAL_STATE_DIR=.local-runtime
# false is correct for an actual MT5 demo account; true is a read-only app preview.
DEMO_MODE=false
ALLOW_LIVE_TRADING=false
BILLING_ENABLED=false
# Default 1 = IOC. Change only if your broker requires another supported mode.
MT5_FILLING_MODE=1

# OPTIONAL FOR A NEW LOCAL SETUP: leave these blank.
# Generated and saved automatically. Existing encrypted credentials require
# their original key, supplied here or preserved in .local-runtime/vault-key.
VAULT_KEY=
# Blank uses PUBLIC_URL. With manage run, both URLs must match.
COPIER_URL=
# Blank lets manage run provision the account token automatically.
# Set only to reuse an existing token; required for a standalone platform_agent.
AGENT_TOKEN=
# Blank uses a per-account journal (standalone: platform-worker.db).
# Set to your existing journal path when migrating an older worker command.
WORKER_STATE=
# Needed only to select among multiple local accounts when AGENT_TOKEN is blank.
# The selection ID is shown on the account card.
LOCAL_ACCOUNT_ID=

# ADVANCED / OPTIONAL: not needed for normal local copying.
# Required only for a managed terminal pool: random 48+ byte supervisor token.
SUPERVISOR_TOKEN=
# Required when enabling Stripe billing; otherwise leave blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
# Optional password-reset email delivery. Configure for your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional MT5 master-account signal source (alternative to Discord).
# Configure these only when running the master bridge.
SIGNAL_INGEST_TOKEN=
MIRROR_ANALYST_ID=
MASTER_TERMINAL_PATH=
MASTER_LOGIN=
MASTER_SERVER=
MASTER_SYMBOL=XAUUSD
