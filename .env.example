# Copy to .env, then run:
#   python -m goldcopier.manage run
# Configure direct broker copying in Operator console; Discord logs are optional.

# --- Optional Discord logs / alternative Discord-message input -------------
DISCORD_BOT_TOKEN=
# Right-click the signal channel > Copy Channel ID (Discord Developer Mode on).
DISCORD_CHANNEL_ID=
# Right-click the signal poster (human or bot) > Copy User ID.
DISCORD_TRADER_ID=

# --- MT5: leave blank if MetaTrader 5 is already logged in to your demo -------
# account with "Save password" ticked. Login, server, demo/live and the gold
# symbol are then read from the terminal. MT5_PASSWORD is the trading password.
MT5_LOGIN=
MT5_SERVER=
MT5_PASSWORD=

# --- Optional overrides (blank = automatic) ---------------------------------
# App login. Blank: admin@goldcopier.local with a generated password saved in
# .local-runtime/admin-password (printed on first start).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Blank: the only terminal64.exe under Program Files.
MT5_TERMINAL_PATH=
# Blank: XAUUSD, or your broker's variant such as XAUUSDm.
MT5_SYMBOL=
# Blank: looked up from DISCORD_CHANNEL_ID with the bot token.
DISCORD_GUILD_ID=
ANALYST_NAME=

# --- Advanced: not needed for local copying ---------------------------------
# Defaults: PUBLIC_URL=http://127.0.0.1:8001, LOCAL_STATE_DIR=.local-runtime,
# PLATFORM_DB=<state dir>/platform.db, MT5_FILLING_MODE=1 (IOC),
# ALLOW_LIVE_TRADING=false, BILLING_ENABLED=false.
# VAULT_KEY is generated into .local-runtime/vault-key; keep that file.
# AGENT_TOKEN is provisioned automatically by manage run. For a standalone
# platform_agent, create one with: python -m goldcopier.manage worker-token
# Optional features (see docs/PLATFORM.md): SUPERVISOR_TOKEN, STRIPE_*, SMTP_*,
# SIGNAL_INGEST_TOKEN, MIRROR_ANALYST_ID, MASTER_* and LOCAL_ACCOUNT_ID.

# Separate sender bot for scripts/test_signal_bot.py (not the listener's token).
TEST_DISCORD_BOT_TOKEN=

# --- Direct broker source: separate terminals for trader and follower --------
# Configure the trader account and analyst in Operator console first.
# MT5_TERMINAL_PATH above is the follower terminal when using both locally.
MASTER_TERMINAL_PATH=
MASTER_ACCOUNT_ID=
MASTER_AGENT_TOKEN=
MASTER_PASSWORD=
MASTER_WORKER_STATE=
# Use a saved trader login or investor/read-only password where possible.
# None of MASTER_LOGIN / MASTER_SERVER / MIRROR_ANALYST_ID / SIGNAL_INGEST_TOKEN
# are needed: the trader worker uses its own account-scoped AGENT_TOKEN.

# --- Hosted community service: configured once by the service operator -------
# PUBLIC_URL=https://your-service.example
# BILLING_ENABLED=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_PRO=
# Master subscriber payments use Stripe Connect Express.
# COMMUNITY_APPLICATION_FEE_PERCENT=0
# Register PUBLIC_URL/api/community-discord/callback with this Discord app.
# DISCORD_APPLICATION_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=  # reuse the service bot token configured above
# Shared only between platform and supervisor host; never given to customers.
# SUPERVISOR_TOKEN=
# COPIER_URL=https://your-service.example
# TERMINAL_POOL=terminal-pool.json
# Start the supervisor as a monitored service; see docs/COMMUNITIES.md.

# Optional Discord signal display units. Gold defaults to $0.10 per pip.
# Set the same mapping on the API and Discord sender; this does not change risk.
# DISCORD_PIP_SIZES={"XAUUSD":0.1,"BTCUSD":1}
# Configure alert role IDs in Community -> Choose Discord channel.
